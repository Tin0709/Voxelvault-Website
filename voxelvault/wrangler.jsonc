{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxelvault-api",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-27",
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "voxelvault-private"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "APP_ORIGINS": ""
  }
  // Before deployment, configure the production APP_ORIGIN / APP_ORIGINS.
  // Future non-secret variables: SUPABASE_URL, PUBLIC_API_URL.
  // Set SUPABASE_SERVICE_ROLE_KEY and IMAGE_SIGNING_SECRET with Wrangler secrets.
  // Local development uses simulated R2; do not enable remote bindings here.
}

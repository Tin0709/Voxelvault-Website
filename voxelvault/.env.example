# Browser-safe values from Supabase > Connect / API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated providers enabled in your Supabase dashboard.
# Supported UI providers: google,facebook,github,discord,azure
VITE_AUTH_PROVIDERS=google,facebook
# Local Vite proxies /api to port 8787. Leave blank locally.
VITE_API_URL=

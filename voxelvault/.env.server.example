# Copy to .env.server.local. NEVER prefix server secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voxelvault-private
APP_ORIGIN=http://localhost:5173
PORT=8787
HOST=127.0.0.1
# For small production instances use 1; accepted range 1–4.
MAX_CONCURRENT_UPLOADS=4

# Optional extra exact frontend origins for LAN testing, comma-separated.
APP_ORIGINS=

# Optional when frontend and API have different public origins (no trailing slash).
PUBLIC_API_URL=
# Optional stable server-only HMAC secret; falls back to SUPABASE_SERVICE_ROLE_KEY.
IMAGE_SIGNING_SECRET=
